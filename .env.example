# ── 서버 ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# 관리자 로그인 토큰 서명 키. 반드시 길고 무작위한 값으로 바꾸세요.
JWT_SECRET=change-me-to-a-long-random-string

# ── 데이터베이스 ──────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/vlm

# ── Claude API (서버에만 보관. 절대 앱에 넣지 마세요) ──
ANTHROPIC_API_KEY=sk-ant-여기에-키
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_ACCURATE=claude-sonnet-5

# ── 원가 계산 (요금 청구·통계용) ──────────────────────
USD_KRW=1530
PRICE_IN_FAST=1.00
PRICE_OUT_FAST=5.00
PRICE_IN_ACC=3.00
PRICE_OUT_ACC=15.00

# ── 이미지 저장 ───────────────────────────────────────
IMAGE_DIR=./data/images
IMAGE_RETENTION_DAYS=30

# ── 알림: 카카오 알림톡 (계약 후 발급받은 값 입력) ────
KAKAO_API_URL=
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
KAKAO_TEMPLATE_ALERT=

# ── 알림: SMS ─────────────────────────────────────────
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# ── 알림: 이메일(SMTP) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alert@example.com

# ── 결제 (토스페이먼츠 / 아임포트 등) ─────────────────
PG_PROVIDER=toss
PG_SECRET_KEY=
PG_API_URL=https://api.tosspayments.com/v1
